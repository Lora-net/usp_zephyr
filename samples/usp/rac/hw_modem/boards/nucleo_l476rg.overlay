/ {
	/*
	 * Host UART is auto-selected by the sample from chosen "zephyr,console"
	 * (usart2 = ST-Link VCP on this board, set by the base board DTS).
	 * No "smtc-hal-uart" alias needed here; define one only to force a
	 * different UART than the console.
	 */
	zephyr,user {
		/* PINS used for the HW modem sample. */
		hw-modem-led-scan-gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>;
	};

	aliases {
		smtc-watchdog = &iwdg;
	};
};

//Label for flash controller (needed cause we need properties, and we grab alias in user code)
smtc_flash: &flash0 {};

&lptim1 {
	clocks = <&rcc STM32_CLOCK_BUS_APB1 0x80000000>,
		 <&rcc STM32_SRC_LSE LPTIM1_SEL(3)>;
	status = "okay";
};

&spi3 {
	status = "disabled";
};

&iwdg {
	status = "disabled";
};

&arduino_spi {
	/delete-property/ overrun-character;
};

&arduino_i2c {
        /delete-property/ zephyr,concat-buf-size;
};

// Set SPI freq @10MHz for this sample
&{/soc/spi@40013000/lora@0} {
	spi-max-frequency = < 10000000 >; 
};

&arduino_spi {
        /delete-property/ overrun-character;
        // Uncomment those 3 lines to activate DMA on STM32L4
        dmas = <&dma1 3 1 (STM32_DMA_PERIPH_TX | STM32_DMA_PRIORITY_HIGH)>,
               <&dma1 2 1 (STM32_DMA_PERIPH_RX | STM32_DMA_PRIORITY_HIGH)>;
        dma-names = "tx", "rx";
};

// Uncomment those 3 lines to activate DMA on STM32L4
&dma1 {
        status = "okay";
};
