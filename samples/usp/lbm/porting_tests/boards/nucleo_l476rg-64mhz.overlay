/ {
	aliases {
		smtc-watchdog = &iwdg;
		smtc-user-button = &user_button;
	};
};

// Uncomment the following 3 sections to set board @64MHz (instead of 80) and SPI@16MHz (instead of 10)
&pll {
	mul-n = <16>; 
};

&rcc {
	clock-frequency = < 64000000 >;
};

&{/soc/spi@40013000/lora@0} {
	spi-max-frequency = < 16000000 >; 
};
// END 64MHz --------------------------------------------------------

&spi3 {
	status = "disabled";
};

&iwdg {
	status = "disabled";
};

&arduino_spi {
	/delete-property/ overrun-character;
};

&arduino_i2c {
        /delete-property/ zephyr,concat-buf-size;
};

&lptim1 {
	clocks = <&rcc STM32_CLOCK_BUS_APB1 0x80000000>,
		 <&rcc STM32_SRC_LSE LPTIM1_SEL(3)>;
	status = "okay";
};
